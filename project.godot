; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Come and Fight"
config/version="0.2"
run/main_scene="uid://33dxx3gjhep8"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://AudioBus/default_bus_layout.tres"

[autoload]

RoundManager="*res://Scripts/Globals/RoundManager.gd"

[display]

window/size/viewport_width=1908
window/size/viewport_height=964
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://Art/": "pink",
"res://AudioBus/": "gray",
"res://Config/": "red",
"res://Music/": "blue",
"res://Scenes/": "orange",
"res://Scripts/": "yellow",
"res://SoundEffects/": "teal"
}

[global_group]

Enemigos="Recogerá todos los enemigos del jugador"
Balas="Munición de las armas"

